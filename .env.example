# Copy to .env.local and fill in your own values. Never commit .env.local.

# Canonical origin used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SITE_URL=http://localhost:3000

# Public support address shown on contact, privacy and terms pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional: Google Analytics 4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# ClassForge needs no database or API keys: all student data stays in the browser.
