# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase project (Project Settings -> API). The publishable/anon key is browser-safe;
# protect data with Row Level Security (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy alternative to the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SITE_URL=http://localhost:3000

# Public support address shown on contact, privacy and terms pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional: Google Analytics 4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Optional: server-only Gemini API key for the /api/chat assistant.
GEMINI_API_KEY=

# Optional: comma-separated emails allowed into the Agent Lab (/agents). Empty = nobody.
POS_OWNER_EMAILS=
